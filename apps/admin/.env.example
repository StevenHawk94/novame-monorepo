# admin/.env.example -- copy to .env.local and fill in real values.
# Vercel: set the same keys in Project Settings -> Environment Variables.

# Supabase (required for all admin routes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin email whitelist (comma-separated)
ADMIN_EMAILS=

# API server URL for proxy rewrites (orders / force-update / etc)
NOVAME_API_URL=http://localhost:3001

# Cloudflare R2 (Stage B onwards -- product asset uploads)
# Generate API token at: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# Permissions: Object Read & Write, scoped to the specific bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=novame-videos
R2_PUBLIC_URL=https://media.novameapp.com
