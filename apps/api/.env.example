# ──────────────────────────────────────────────
# Supabase (REQUIRED)
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ──────────────────────────────────────────────
# AI providers (REQUIRED)
# ──────────────────────────────────────────────
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ──────────────────────────────────────────────
# Apple In-App Purchase (REQUIRED for iOS)
# ──────────────────────────────────────────────
APPLE_SHARED_SECRET=

# ──────────────────────────────────────────────
# Google Play Billing (REQUIRED for Android)
# ──────────────────────────────────────────────
# Complete JSON key for the Play Console service account. The legacy
# GOOGLE_PLAY_SERVICE_ACCOUNT name is still accepted by the API routes.
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=

# Google Play RTDN is delivered through an authenticated Pub/Sub push
# subscription. Keep REQUIRE_AUTH=false until the push subscription has been
# configured with the exact audience and service account below, then switch it
# to true in every deployed environment.
GOOGLE_PUBSUB_REQUIRE_AUTH=false
GOOGLE_PUBSUB_PUSH_AUDIENCE=https://api.soulsayit.com/api/webhooks/google
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=

# ──────────────────────────────────────────────
# Google Cloud Vision (used in admin OCR / analysis)
# ──────────────────────────────────────────────
GOOGLE_CLOUD_VISION_API_KEY=

# ──────────────────────────────────────────────
# Airwallex Payment (REQUIRED for book/card orders)
# ──────────────────────────────────────────────
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_ENV=demo
PAYMENT_MODE=test

# ──────────────────────────────────────────────
# Cloudflare R2 (object storage, S3-compatible)
# ──────────────────────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# ──────────────────────────────────────────────
# Email (Resend — for support tickets etc.)
# ──────────────────────────────────────────────
RESEND_API_KEY=

# ──────────────────────────────────────────────
# Public URLs
# ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://api.soulsayit.com
NEXT_PUBLIC_APP_URL=https://novame.app

# ──────────────────────────────────────────────
# Access control
# ──────────────────────────────────────────────
# Comma-separated UUIDs allowed to call admin endpoints
# (orders admin mode, force-update manage, support-ticket GET/PATCH)
ADMIN_USER_IDS=

# Comma-separated UUIDs allowed to use POST /api/dev/set-tier (test tooling).
# LEAVE UNSET IN PRODUCTION — unset means the route rejects everyone.
DEV_TIER_TESTER_IDS=

# Extra browser origins granted CORS, comma-separated (e.g. deployed Admin domain).
# Native mobile sends no Origin header and needs no entry here.
CORS_ALLOWED_ORIGINS=
