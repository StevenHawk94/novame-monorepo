      "friendId": "adventure_friend_pk",
      "phase": "Intro",
      "seq": 2,
      "familiarity": "Familiar Face",
      "type": "Statement",
      "scene": null,
      "lines": [
        "I've been hugging a pillow for a week.",
        "Practicing. Without poking. It's not working. I've gone through four pillows."
      ],
      "choices": [
        {
          "id": "a",
          "label": "Why the practice?",
          "reaction": [
            "...No reason. A boy. Maybe. I don't want to talk about it."
          ]
        },
        {
          "id": "b",
          "label": "Four pillows? Respect.",
          "reaction": [
            "Thank you. I'm committed."
          ]
        },
        {
          "id": "c",
          "label": "Want some tips?",
          "reaction": [
            "No. Yes. Maybe. I'm FINE."
          ]
        }
      ],
      "outro": null
    },
    {
