      "type": "Statement",
      "scene": "A hedgehog stands very still, spikes slightly up.",
      "lines": [
        "Don't touch. I'm not mad. I'm just... spiky.",
        "It's a lot. I know."
      ],
      "choices": [
        {
          "id": "a",
          "label": "Noted. No touching.",
          "reaction": [
            "Thank you. Finally someone gets it."
          ]
        },
        {
          "id": "b",
          "label": "I like your spikes.",
          "reaction": [
            "...You do? Weird. I'm Pickles."
          ]
        },
        {
          "id": "c",
          "label": "Are you okay?",
          "reaction": [
            "I'm FINE."
          ]
        }
      ],
      "outro": null
    },
    {
