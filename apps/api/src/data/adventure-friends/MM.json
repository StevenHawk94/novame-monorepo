  "dialogues": [
    {
      "id": "MM-01",
      "friendId": "adventure_friend_mm",
      "phase": "Intro",
      "seq": 1,
      "familiarity": "Stranger",
      "type": "Statement",
      "scene": "A pair of round glasses peeks out of a fresh dirt mound.",
      "lines": [
        "Hm. You're standing on my roof.",
        "...Not complaining. Just saying. Roof. Mine."
      ],
      "choices": [
        {
          "id": "a",
          "label": "Oh! Sorry!",
          "reaction": [
            "Hm. Accepted. Mr Mole. Tunnels, mostly."
          ]
        },
        {
          "id": "b",
          "label": "Nice roof.",
          "reaction": [
            "...Nobody's said that before. Hm. Best work I've done."
          ]
        },
        {
          "id": "c",
          "label": "Tiptoe off quietly",
          "reaction": [
            "Hm. Polite. I like quiet."
          ]
        }
      ],
      "outro": null
    },
    {
      "id": "MM-02",
      "friendId": "adventure_friend_mm",
      "phase": "Intro",
      "seq": 2,
      "familiarity": "Familiar Face",
      "type": "Statement",
      "scene": null,
      "lines": [
        "Been digging this tunnel three weeks. No reason.",
        "Digging helps me think. About nothing. Mostly."
      ],
      "choices": [
        {
          "id": "a",
          "label": "What do you think about?",
          "reaction": [
            "Hm. Dinner. Mostly."
          ]
        },
        {
          "id": "b",
          "label": "That's kind of cool.",
          "reaction": [
            "Hm. Thanks. Cool's good."
          ]
        },
        {
          "id": "c",
          "label": "Can I help?",
          "reaction": [
            "...No. But thanks. Maybe next time."
          ]
        }
      ],
      "outro": null
    },
    {
      "id": "MM-03",
      "friendId": "adventure_friend_mm",
      "phase": "Intro",
      "seq": 3,
      "familiarity": "Acquaintance",
      "type": "Statement",
      "scene": null,
      "lines": [
        "Mabel made worm pie today. Best in the burrow.",
        "Don't tell her I said that. She'll get ideas."
      ],
      "choices": [
        {
          "id": "a",
          "label": "Why not?",
          "reaction": [
            "She'll make it every day. Then I'll have to say 'delicious' every day."
          ]
        },
        {
          "id": "b",
          "label": "You're smiling.",
          "reaction": [
            "...Am not. Hm. Maybe a little."
          ]
        },
        {
          "id": "c",
          "label": "Worm pie? ...okay!",
          "reaction": [
            "Don't knock it till you've tried it."
          ]
        }
      ],
      "outro": null
    },
    {
      "id": "MM-04",
      "friendId": "adventure_friend_mm",
      "phase": "Intro",
      "seq": 4,
      "familiarity": "Acquaintance",
      "type": "Statement",
      "scene": null,
      "lines": [
        "Every anniversary I dig Mabel a new window. Nineteen now.",
        "Burrow looks like cheese."
      ],
      "choices": [
        {
          "id": "a",
          "label": "That's the sweetest thing.",
          "reaction": [
            "Hm. She says thanks every time. I say 'hm.' That's our whole conversation."
          ]
        },
        {
          "id": "b",
          "label": "Does she know why?",
          "reaction": [
            "...She knows."
          ]
        },
        {
          "id": "c",
          "label": "Twenty's coming up, right?",
          "reaction": [
            "Hm. Yes. Thinking about it. Not talking about it."
          ]
        }
      ],
      "outro": null
    },
    {
      "id": "MM-05",
      "friendId": "adventure_friend_mm",
      "phase": "Intro",
      "seq": 5,
      "familiarity": "Friend",
      "type": "Ask",
      "scene": null,
      "lines": [
        "Mabel said last night: 'You never tell me anything.'",
        "I said, 'I dug you a window.' She said, 'I know. I want words.'",
        "Hm. What do you and your partner say to each other? Normal stuff?"
      ],
      "choices": [
        {
          "id": "a",
          "label": "A lot of 'good morning' and 'I'm hungry.'",
          "reaction": [
            "Hungry. I can do hungry."
          ]
        },
        {
          "id": "b",
          "label": "Sometimes I just say 'I'm glad it's you.'",
          "reaction": [
            "...Four words. I can carry four words."
          ]
        },
        {
          "id": "c",
          "label": "Maybe start tiny? One sentence a day?",
          "reaction": [
            "One sentence. Hm. Like a pebble. I give pebbles."
          ]
        }
      ],
      "outro": null
    },
    {
      "id": "MM-06",
      "friendId": "adventure_friend_mm",
      "phase": "Intro",
      "seq": 6,
      "familiarity": "Friend",
      "type": "Statement",
      "scene": null,
      "lines": [
        "I said 'nice dress' to Mabel yesterday.",
        "She said, 'This is my gardening apron.'",
        "She laughed so hard she cried. Best thing I've done in years. Accidentally."
      ],
      "choices": [
        {
          "id": "a",
          "label": "That totally counts!",
          "reaction": [
            "Hm. Counts. Okay."
          ]
        },
        {
          "id": "b",
          "label": "At least she laughed.",
          "reaction": [
            "She did. I wrote it down."
          ]
        },
        {
          "id": "c",
          "label": "Try 'nice apron' next time.",
          "reaction": [
            "...Hm. Nice apron. Practicing."
          ]
        }
      ],
      "outro": null
    },
    {
      "id": "MM-07",
      "friendId": "adventure_friend_mm",
      "phase": "Intro",
      "seq": 7,
      "familiarity": "Close Friend",
      "type": "Confide",
      "scene": "Evening. Mr Mole sits at the tunnel mouth, not digging.",
      "lines": [
        "Can I say something? Don't laugh.",
        "I think Mabel might be bored of me. She's bright. Everyone loves her at burrow parties.",
        "I'm the guy near the snacks."
      ],
      "choices": [
        {
          "id": "a",
          "label": "I don't think she's bored.",
          "reaction": [
            "Hm. You might be right. I hope."
          ]
        },
        {
          "id": "b",
          "label": "What makes you think that?",
          "reaction": [
            "She laughs more with other people. That's all. It's fine. Hm."
          ]
        },
        {
          "id": "c",
          "label": "Sit quietly next to him",
          "reaction": [
            "...Thanks. Not many people know how to do that."
          ]
        }
      ],
      "outro": null
    },
    {
      "id": "MM-08",
      "friendId": "adventure_friend_mm",
      "phase": "Intro",
      "seq": 8,
      "familiarity": "Close Friend",
      "type": "Statement",
      "scene": null,
      "lines": [
        "Mabel's birthday is Friday. I wrote something.",
        "Three sentences. Been practicing on a worm."
      ],
      "choices": [
        {
          "id": "a",
          "label": "Read it to me!",
          "reaction": [
            "Hm. Okay.",
            "'Mabel. You're my favorite noise. The house is loud because of you, and I like it.' ...Too much?"
          ]
        },
        {
          "id": "b",
          "label": "Practice on me, not the worm.",
          "reaction": [
            "Worm's offended. Fine. Listen.",
            "'Mabel. You're my favorite noise. The house is loud because of you, and I like it.' ...Too much?"
          ]
        },
        {
          "id": "c",
          "label": "Three sentences is plenty.",
          "reaction": [
            "Hm. Three is a lot. For me."
          ]
        }
      ],
      "outro": "Friday. Wish me luck."
    },
    {
      "id": "MM-09",
      "friendId": "adventure_friend_mm",
      "phase": "Intro",
      "seq": 9,
      "familiarity": "Best Friend",
      "type": "Companion",
      "scene": null,
      "lines": [
        "Mabel's at her sister's for a week.",
        "House is too quiet. Never noticed how much noise she makes. Humming. Pots. Talking to the plants.",
        "I keep setting two cups."
      ],
      "choices": [
        {
          "id": "a",
          "label": "Aw. Send her a note?",
          "reaction": [
            "Already wrote it. Four lines. Scared to send."
          ]
        },
        {
          "id": "b",
          "label": "Tell her you miss her.",
          "reaction": [
            "That's the thing. I do. I never said it. Twenty years."
          ]
        },
        {
          "id": "c",
          "label": "Want some company tonight?",
          "reaction": [
            "...Yeah. I'd like that."
          ]
        }
      ],
      "outro": "I'm sending it. 'Quiet here without you.' That's all."
    },
    {
