      "friendId": "adventure_friend_mm",
      "phase": "Intro",
      "seq": 10,
      "familiarity": "Old Friend",
      "type": "Milestone",
      "scene": null,
      "lines": [
        "Hm. You came again. Ten times. I counted. Don't tell anyone I counted.",
        "Mabel read my three sentences. She cried. Then asked who wrote them. I said me. She said, 'Liar.'",
        "...I got that on my own. Mostly.",
        "My turn to ask. How are you and your partner? Honest."
      ],
      "choices": [
        {
          "id": "a",
          "label": "We're good. Still learning.",
          "reaction": [
            "Hm. Twenty years in and I'm still learning. Come to dinner. Mabel's been asking."
          ]
        },
        {
          "id": "b",
          "label": "We had a rough week, honestly.",
          "reaction": [
            "Hm. Rough weeks happen. Come by. Mabel will feed you both."
          ]
        },
        {
          "id": "c",
          "label": "Better since I started saying the small things.",
          "reaction": [
            "...You were listening to yourself too. Good. Dinner. Bring your partner."
          ]
        }
      ],
      "outro": null
