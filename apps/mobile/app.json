{
  "expo": {
    "name": "Burrow",
    "slug": "novame-mobile",
    "version": "1.0.25",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "novame",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/branding/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#3f150b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.novame.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Burrow uses only the photos you select for your room frame, plushie, and profile.",
        "NSCameraUsageDescription": "Burrow uses the camera only when you choose to take a room, plushie, or profile photo."
      },
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.novame.app"
        ]
      },
      "appleTeamId": "VFUC7899NP"
    },
    "android": {
      "package": "com.burrow.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/android-adaptive-foreground.png",
        "backgroundColor": "#3f150b"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/branding/favicon-32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf"
          ]
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Burrow uses the camera only when you choose to align your face inside an interactive plushie."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Burrow uses photos you choose for your profile, room frame, and plushie, visible to your paired partner.",
          "cameraPermission": "Burrow uses the camera only when you choose to take a photo for your room or plushie."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/with-android-r8-optimization",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.966579113880-fd110tglqc5bnciu3nk9s3b6h87avuqm"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Burrow uses your microphone when you choose to record a private surprise message for your partner."
        }
      ],
      "./plugins/with-foreground-audio-only",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8A6240",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-iap",
      "./plugins/with-ios-modular-headers",
      "./plugins/with-tiktok-business-sdk",
      "expo-asset",
      [
        "react-native-fbsdk-next",
        {
          "appID": "1511452757474099",
          "clientToken": "5fb5094e9754979501cb27b54f764050",
          "displayName": "Burrow-Reflect & Stay Close",
          "scheme": "fb1511452757474099",
          "advertiserIDCollectionEnabled": false,
          "autoLogAppEventsEnabled": false,
          "isAutoInitEnabled": false,
          "iosUserTrackingPermission": false
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "VFUC7899NP"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-logo.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#3f150b",
          "android": {
            "image": "./assets/branding/splash-logo.png",
            "imageWidth": 140,
            "backgroundColor": "#3f150b"
          }
        }
      ],
      "@sentry/react-native/expo",
      ["expo-secure-store", { "faceIDPermission": false, "configureAndroidBackup": false }],
      "./plugins/with-encrypted-storage-backup",
      "./plugins/with-mobile-branding"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "734e8969-2007-4fba-ad80-e3e04beaaa68"
      }
    },
    "owner": "stevenhawk2333"
  }
}
