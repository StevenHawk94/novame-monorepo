# Mirror the root release policy. EAS_NO_VCS builds explicitly use the repository
# root via EAS_PROJECT_ROOT; keep this copy safe for other CLI/VCS modes too.

# Dependencies and VCS metadata
node_modules/
.pnpm-store/
.git

# Deployment/provider metadata is local-only and not a mobile build input.
.vercel/
**/.vercel/
supabase/.temp/
/supabase/.temp/

# Other applications and backend/development workspaces are not mobile build inputs.
apps/admin/
apps/api/*
!apps/api/src/
!apps/api/src
apps/api/src/*
!apps/api/src/data/
!apps/api/src/data
apps/api/src/data/*
!apps/api/src/data/burrow-game-room-v1.json
docs/
supabase/
tools/
outputs/
.agents/
.codex/

# Build and framework outputs
dist/
build/
.next/
.expo/
.expo-shared/
.turbo/
*.tsbuildinfo

# Environment and local files
.env
.env.local
.env.*.local
.env.local.*
!.env.example
.DS_Store
Thumbs.db
.~*
.vscode/
.idea/
*.swp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated native projects and artifacts
/apps/mobile/ios/
/apps/mobile/android/
*.ipa
*.apk
*.aab
*.keystore
!debug.keystore
expo-env.d.ts

# Development and source-only assets
tools/item-source/memory-items/
design-refs/
__pycache__/
_admin-api-tmp/
_old-*
*.tmp
*.zip
video-manifest.json

# Apple authentication keys
*.p8
AuthKey_*.p8
*.p12
*.pem
*.key
*.jks
*.mobileprovision
credentials.json

# Firebase Admin / FCM V1 service-account private keys
**/*firebase-adminsdk*.json
**/firebase-fcm-service-account*.json

# Original Tap Your Day sheet; only the five cropped WebPs are runtime assets.
/tools/item-source/tap-your-day/

# Source-only New Lens workbook; runtime content is already generated.
/tools/New_Lens_Content.xlsx

/apps/api/.env.example
/apps/admin/.env.example
# Catalog authoring/publication inputs are not native runtime assets.
/catalog/
