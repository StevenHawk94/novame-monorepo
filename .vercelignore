# Vercel builds both the API and Admin projects from this monorepo root. Keep
# those apps and their workspace dependencies; mobile assets/native outputs are
# released through EAS and must never be uploaded with either deployment.

# Other applications and non-runtime project material
/apps/mobile/
/docs/
/supabase/
/tools/
/CODEBASE.md
/README.md
/gen-manifest.log
/.easignore

# Workspace packages not used by the API or Admin projects
/packages/ui-tokens/

# Dependencies, framework output, caches, and VCS metadata
**/node_modules/
**/.next/
**/.turbo/
**/.expo/
**/.vercel/
**/.git/
**/dist/
**/build/
**/*.tsbuildinfo

# Local configuration, credentials, logs, and generated archives
**/.env
**/.env.local
**/.env.*.local
**/*.p8
**/AuthKey_*.p8
**/*.keystore
**/*.ipa
**/*.apk
**/*.aab
**/*.zip
**/*.log
**/.DS_Store
**/Thumbs.db
**/__pycache__/
