  "findings": [
    {
      "id": "AUD-01",
      "priority": "P1",
      "status": "confirmed_failure_coupling",
      "title": "启动 bootstrap 将核心页面与补充数据绑定为同一失败域",
      "evidence": [
        "apps/api/src/app/api/vnext/bootstrap/route.js:48",
        "apps/api/src/app/api/vnext/bootstrap/route.js:59",
        "apps/api/src/app/api/vnext/bootstrap/route.js:68",
        "apps/mobile/src/lib/app-major-update-api.ts:173"
      ],
      "observation": "核心 RPC 成功后仍等待 bonus、collection、wallet、photoUsage、care；部分补充查询错误会抛出整个请求 500。客户端全链路 5 秒截止会进一步放大慢查询的影响。",
      "impact": "某个非核心数据读取失败或较慢，会让本可用的 Home/入口表现成整体加载失败；这是代码路径证据，未测量线上各查询耗时，不能直接认定既往每次卡顿都由它引起。",
      "recommendation": "优先处理。按核心场景/商品配置/可选状态拆分有版本的快照，设独立耗时预算；非授权性展示字段可保留同 scope 最近确认值。余额、订阅、价格、配对和结算写入保持服务端权威，不用默认免费或无限额度兜底。",
      "acceptance": "注入 collection/care 故障时 Home 仍可打开；交易和配对仍 fail closed；启动 p50/p95 和各 RPC 时长可观测。"
    },
    {
      "id": "AUD-02",
      "priority": "P2",
      "status": "confirmed_unnecessary_new_mode_work",
      "title": "已退役 Connection 的全局恢复工作仍执行",
      "evidence": [
        "apps/mobile/app/(main)/(tabs)/status.tsx:4",
        "apps/mobile/src/lib/pairing-realtime.ts:115",
        "apps/mobile/src/lib/pairing-realtime.ts:219",
        "apps/mobile/src/lib/pairing-realtime.ts:225",
        "apps/mobile/src/lib/pairing-realtime.ts:408"
      ],
      "observation": "status 路由已直接重定向 Home，但全局 pairing channel 的 SUBSCRIBED 仍恢复 Connection history/Insights；配对恢复还会拉旧 feed 和 Bags。",
      "impact": "启动、回前台或重连有额外网络/解析/缓存工作。未实测节省毫秒数。",
      "recommendation": "建议处理。保留配对、Unpair、邀请和权限失效事件；将旧 Connection/旧 Memories 数据恢复限制到确有旧功能消费者时，而不是删除整个配对监听。",
      "acceptance": "新版连接恢复不调用旧历史/Insights/Bags；双方 Unpair、重新配对、共享 Plus 和 Menu 日期仍及时同步。"
    },
    {
      "id": "AUD-03",
      "priority": "P2",
      "status": "measured_bundle_bytes",
      "title": "旧大词典仍进入生产移动 JS 包，且存在顶层初始化",
